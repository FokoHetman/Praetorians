; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Praetorians"
run/main_scene="uid://cc7oe8tjpxrp7"
config/features=PackedStringArray("4.4")
config/icon="res://textures/icon.png"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/fullscreen=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

[internationalization]

locale/translations=PackedStringArray("res://translations/provinces.en.translation", "res://translations/provinces.pl.translation", "res://translations/strings.en.translation", "res://translations/strings.pl.translation", "res://translations/factions.en.translation", "res://translations/factions.pl.translation")

[physics]

common/enable_pause_aware_picking=true

[rendering]

textures/canvas_textures/default_texture_filter=0
